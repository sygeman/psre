{
  "name": "psre",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "PSRE monorepo",
  "license": "MIT",
  "packageManager": "bun@1.2.15",
  "type": "module",
  "scripts": {
    "dev": "bun --elide-lines=0 --filter './apps/*' dev",
    "codegen": "graphql-codegen --require dotenv/config --config codegen.ts"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/near-operation-file-preset": "3.0.1",
    "@graphql-codegen/schema-ast": "4.1.0",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-operations": "4.6.1"
  },
  "dependencies": {
    "graphql": "16.11.0"
  }
}
