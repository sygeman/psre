{
  "name": "psre",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "PSRE monorepo",
  "license": "MIT",
  "packageManager": "bun@1.2.21",
  "type": "module",
  "scripts": {
    "dev": "bun --elide-lines=0 --filter './apps/*' dev",
    "kill-ports": "kill $(lsof -t -i:4000) & kill $(lsof -t -i:4500)",
    "format": "biome format --write",
    "lint": "biome lint --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5"
  }
}
